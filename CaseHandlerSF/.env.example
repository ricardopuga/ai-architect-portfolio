# Salesforce OAuth (Client Credentials flow) — copy to .env and fill in
SF_DOMAIN_URL=https://yourdomain.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v65.0

# Clients must send this in the X-API-Key header; generate one with: openssl rand -hex 32
API_KEY=

# MCP server: Postgres with the Knowledge base chunks (this is the default)
KNOWLEDGE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge

# HTTP API, POST /cases/{key}/suggested-reply: the Bedrock Knowledge Base to search, and Claude
BEDROCK_KB_ID=
BEDROCK_KB_REGION=eu-west-1
ANTHROPIC_API_KEY=
